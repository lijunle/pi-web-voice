{
  "name": "pi-web-voice",
  "version": "0.1.7",
  "description": "Voice input for pi-web. A NODE_OPTIONS hook that injects a microphone button into the chat composer and transcribes speech with Azure AI Speech, Azure OpenAI, or any OpenAI-compatible endpoint. No fork, no patching, no rebuild.",
  "keywords": [
    "pi",
    "pi-web",
    "pi-coding-agent",
    "voice",
    "dictation",
    "speech-to-text",
    "azure",
    "whisper"
  ],
  "homepage": "https://github.com/lijunle/pi-web-voice#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lijunle/pi-web-voice.git"
  },
  "bugs": {
    "url": "https://github.com/lijunle/pi-web-voice/issues"
  },
  "author": "Junle Li",
  "license": "MIT",
  "main": "hook.cjs",
  "bin": {
    "pi-web-voice": "bin/pi-web-voice.js"
  },
  "files": [
    "hook.cjs",
    "lib",
    "bin",
    "public",
    "README.md",
    "USAGE.md",
    "DEVELOPMENT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "test": "node test/run.mjs",
    "test:unit": "node test/run.mjs unit",
    "test:integration": "node test/run.mjs integration",
    "test:e2e": "node test/run.mjs e2e"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "playwright": "1.63.0",
    "typescript": "^6.0.3"
  }
}
